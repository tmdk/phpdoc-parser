#!/usr/bin/env php
<?php

if ( ! ini_get( 'date.timezone' ) ) {
	ini_set( 'date.timezone', 'UTC' );
}

// Temporarily silence deprecation errors. Remove once all deprecations have been resolved.
set_error_handler( static fn( int $errno ) => $errno === E_DEPRECATED, E_DEPRECATED );

if ( is_file( dirname( __DIR__ ) . '/vendor/phpunit/phpunit/phpunit' ) ) {
	require dirname( __DIR__ ) . '/vendor/phpunit/phpunit/phpunit';
} else {
	echo "Unable to find the phpunit script in `vendor/phpunit/phpunit`. Try running composer install\n";
	exit( 1 );
}
